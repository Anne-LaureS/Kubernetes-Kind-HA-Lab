{
  "uid": "cpu_cluster",
  "title": "CPU Cluster High Usage",
  "folderUID": "cluster-alerts",
  "ruleGroup": "cluster-alerts",
  "interval": "40s",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "queryType": "timeSeriesQuery",
      "relativeTimeRange": {
        "from": 300,
        "to": 0
      },
      "datasourceUid": "prometheus",
      "model": {
        "expr": "sum(rate(container_cpu_usage_seconds_total[5m]))",
        "refId": "A"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "-100",
      "model": {
        "type": "threshold",
        "expression": "A",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                80
              ]
            }
          }
        ]
      }
    }
  ],
  "for": "5m",
  "noDataState": "NoData",
  "execErrState": "Error",
  "labels": {
    "severity": "warning"
  },
  "annotations": {
    "summary": "CPU cluster usage is high"
  }
}
